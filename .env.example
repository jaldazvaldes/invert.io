# Copia este fichero a .env y rellena solo lo que vayas a usar.
# .env está en .gitignore: nunca se sube al repositorio.

# Modo: backtest | paper | demo | live
TRADING_MODE=paper
# Dinero real: además de TRADING_MODE=live hace falta LIVE_CONFIRM=yes. Solo lo activas tú.
LIVE_CONFIRM=

DATA_DIR=data
CONFIG_DIR=config
LOG_LEVEL=INFO
LOG_JSON=false
PANEL_PORT=8000 # panel web en http://localhost:8000

# --- Revolut X (cripto) ---
# Genera el par de claves Ed25519 en tu equipo, sube la pública en Revolut X y pon aquí
# la API key y la ruta a la clave privada (guárdala fuera del repo).
REVOLUTX_API_KEY=
REVOLUTX_PRIVATE_KEY_PATH=

# --- Trading 212 (acciones, cuenta Invest) ---
# Crea la clave con solo los permisos necesarios y restringida a tu IP.
T212_API_KEY=
T212_API_SECRET=

# --- Alpaca (solo datos de mercado de acciones; cuenta paper gratuita) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
